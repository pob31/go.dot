+    //==============================================================================
+    /** MODIFIED BY GO.DOT (https://github.com/pob31/go.dot), 2026-09-28, by
+        patches/tracktion_engine/0002-launched-clip-speed.patch, which Go.dot's build
+        applies to this Tracktion Engine checkout. This interface is Go.dot's addition.
+
+        A speed for a launched clip that can change while the clip plays. Without one, a
+        launched clip plays its source one-for-one with the Edit's beats, as it always
+        has. With one, the clip's WaveNodeRealTime reads the stretch of source the speed
+        says - Tracktion's own per-block ratio then drives its resampler, or its
+        time-stretcher, from that - and its SlotControlNode ends it where the SOURCE has
+        played the clip's length rather than where the Edit has.
+
+        Both questions are asked on the audio thread, once or twice a block, and must not
+        block, allocate or throw. Tracktion keeps no answer between blocks, so a graph
+        rebuilt in the middle of a change of speed needs nothing carried across it.
+    */
+    struct SpeedSource
+    {
+        virtual ~SpeedSource() = default;
+
+        /** How many source beats BEYOND one-for-one a clip launched at `launch` has
+            played, `sinceLaunch` Edit beats after its launch. Zero at zero, continuous,
+            and never below -sinceLaunch: a source never plays backwards.
+            [[ audio_thread ]]
+        */
+        virtual double extraSourceBeats (MonotonicBeat launch, BeatDuration sinceLaunch) noexcept = 0;
+
+        /** When a clip launched at `launch` will have played `source` beats of its
+            source, or nullopt if, at the speeds known now, it will not.
+            [[ audio_thread ]]
+        */
+        virtual std::optional<MonotonicBeat> whenSourceHasPlayed (MonotonicBeat launch,
+                                                                  BeatDuration source) noexcept = 0;
+    };
+
+    /** Sets the speed this clip plays at, or nullptr for one-for-one. The source must
+        outlive every graph built with this handle. Message thread. */
+    void setSpeedSource (SpeedSource* source) noexcept
+    {
+        speedSource.store (source, std::memory_order_release);
+    }
+
+    /** The speed source, or nullptr. [[ audio_thread ]] */
+    SpeedSource* getSpeedSource() const noexcept
+    {
+        return speedSource.load (std::memory_order_acquire);
+    }
+
     //==============================================================================
     /** Represents two beat ranges where the play state can be different in each. */
     struct SplitStatus
@@ -151,6 +199,11 @@ private:
     //==============================================================================
     // audio-write/read, message-read/write
     std::atomic<double> nudgeBeats { 0.0 };
+
+    //==============================================================================
+    // MODIFIED BY GO.DOT, 2026-09-28 (patch 0002): message-write, audio-read. A copy
+    // of a handle starts with none - the copy constructor copies the played state only.
+    std::atomic<SpeedSource*> speedSource { nullptr };
