+//==============================================================================
+/** MODIFIED BY GO.DOT (https://github.com/pob31/go.dot), 2026-09-29, by
+    patches/tracktion_engine/0002-launched-clip-speed.patch: this reader is Go.dot's addition.
+
+    A loop below the resampler and the stretcher. Its position is the file's, counted on
+    past the loop's end as if the loop were written out pass after pass, and it wraps only
+    where it reads the file: what sits above it - an interpolator, a stretcher - reads one
+    unbroken stream through every pass and is never moved back. Up to the loop's end it is
+    the file, so a stretcher primed at the loop's start is primed on what comes before it,
+    as it would be anywhere else. The loop keeps its exact length in frames, fractions and
+    all, so pass after pass it wraps where the beats above say, and not a fraction of a
+    frame further off each time; and every pass begins on the loop's first frame, the
+    fraction falling at its tail, so a pass never steps over the frame it starts on.
+*/
+class UnrolledLoopReader final  : public SingleInputAudioReader
+{
+public:
+    // MODIFIED BY GO.DOT, 2026-10-06 (patch 0002): and a loop that can move while it
+    // plays, when the launched clip's handle has a LoopSource. Without one, or before its
+    // first segment, every frame is read exactly as before.
+    UnrolledLoopReader (std::unique_ptr<AudioReader> input, double loopStartFrame, double loopLengthFrames,
+                        LaunchHandle::LoopSource* liveLoopSource = nullptr)
+        : SingleInputAudioReader (std::move (input)),
+          own (0, static_cast<SampleCount> (std::llround (loopStartFrame)), loopLengthFrames),
+          live (liveLoopSource)
+    {
+        if (live != nullptr)
+            fadeBuffer = choc::buffer::createChannelArrayBuffer (source->getNumChannels(), fadeChunk, [] { return 0.0f; });
+    }
+
+    SampleCount getPosition() override
+    {
+        return position;
+    }
+
+    void setPosition (SampleCount t) override
+    {
+        position = t;
+        gather();
+        source->setPosition (mapAt (t).fileFrameFor (t));
+    }
+
+    void setPosition (TimePosition t) override
+    {
+        setPosition (toSamples (t, getSampleRate()));
+    }
+
+    bool readSamples (choc::buffer::ChannelArrayView<float>& destBuffer) override
+    {
+        using choc::buffer::FrameCount;
+
+        gather();
+
+        const auto numFrames = static_cast<SampleCount> (destBuffer.getNumFrames());
+        SampleCount done = 0;
+        bool allOk = true;
+
+        while (done < numFrames)
+        {
+            const auto active = activeAt (position);
+            const auto& map = active < 0 ? own : moves[active].map;
+            auto numThisTime = std::min (numFrames - done, map.nextPassAfter (position) - position);
+
+            // A move that starts further on ends this read where it starts.
+            for (int i = 0; i < numMoves; ++i)
+                if (moves[i].from > position)
+                    numThisTime = std::min (numThisTime, moves[i].from - position);
+
+            // A jump fades out of what was being read before it, read alongside.
+            const auto fading = active >= 0 && moves[active].fade > 0
+                                  && position < moves[active].from + moves[active].fade;
+            const auto& before = active > 0 && position >= moves[0].from ? moves[0].map : own;
+
+            if (fading)
+                numThisTime = std::min ({ numThisTime,
+                                          moves[active].from + moves[active].fade - position,
+                                          before.nextPassAfter (position) - position,
+                                          static_cast<SampleCount> (fadeChunk) });
+
+            auto section = destBuffer.getFrameRange ({ (FrameCount) done, (FrameCount) (done + numThisTime) });
+
+            source->setPosition (map.fileFrameFor (position));
+            allOk = source->readSamples (section) && allOk;
+
+            if (fading)
+            {
+                auto out = fadeBuffer.getView().getStart ((FrameCount) numThisTime);
+                source->setPosition (before.fileFrameFor (position));
+                allOk = source->readSamples (out) && allOk;
+
+                // Equal power, the shape of Go.dot's own looper's wraps.
+                const auto length = static_cast<double> (moves[active].fade);
+
+                for (SampleCount i = 0; i < numThisTime; ++i)
+                {
+                    const auto x = (static_cast<double> (position + i - moves[active].from) + 0.5) / length;
+                    const auto in = static_cast<float> (std::sin (x * juce::MathConstants<double>::halfPi));
+                    const auto gone = static_cast<float> (std::cos (x * juce::MathConstants<double>::halfPi));
+
+                    for (choc::buffer::ChannelCount c = 0; c < section.getNumChannels(); ++c)
+                        section.getSample (c, (FrameCount) i) = section.getSample (c, (FrameCount) i) * in
+                                                                  + out.getSample (c, (FrameCount) i) * gone;
+                }
+            }
+
+            position += numThisTime;
+            done += numThisTime;
+        }
+
+        hasRead = true;
+        return allOk;
+    }
+
+private:
+    //==============================================================================
+    // A loop as positions map onto the file: a position is shifted, then read through
+    // the loop as the clip's own always was - the file up to the loop's end, then pass
+    // after pass of the loop. The clip's own loop has no shift.
+    struct Map
+    {
+        SampleCount shift = 0;          // added to a position before the loop applies
+        SampleCount loopStart = 0;      // the loop's first frame
+        double loopLength = 1.0;        // in frames, with its fraction
+        SampleCount lastInLoop = 0;     // the furthest a pass reads past its first frame
+
+        Map() = default;
+
+        Map (SampleCount shiftToUse, SampleCount start, double length)
+            : shift (shiftToUse), loopStart (start), loopLength (std::max (length, 1.0)),
+              lastInLoop (static_cast<SampleCount> (std::ceil (loopLength)) - 1)
+        {
+        }
+
+        // Which pass a shifted position is in: nought up to the loop's end.
+        SampleCount passOf (SampleCount u) const
+        {
+            const auto intoLoop = static_cast<double> (u - loopStart);
+
+            return intoLoop < loopLength ? 0
+                                         : static_cast<SampleCount> (std::floor (intoLoop / loopLength));
+        }
+
+        // The frame of the file a position reads.
+        SampleCount fileFrameFor (SampleCount t) const
+        {
+            const auto u = t + shift;
+            const auto pass = passOf (u);
+
+            if (pass == 0)
+                return u;
+
+            const auto intoPass = static_cast<SampleCount> (std::floor (static_cast<double> (u - loopStart)
+                                                                         - static_cast<double> (pass) * loopLength));
+
+            return loopStart + std::clamp (intoPass, SampleCount (0), lastInLoop);
+        }
+
+        // The first position of the pass after the one t is in.
+        SampleCount nextPassAfter (SampleCount t) const
+        {
+            const auto u = t + shift;
+            const auto pass = passOf (u);
+            auto next = std::max (u + 1, loopStart + static_cast<SampleCount> (std::ceil (static_cast<double> (pass + 1) * loopLength)));
+
+            while (next > u + 1 && passOf (next - 1) > pass)
+                --next;
+
+            while (passOf (next) <= pass)
+                ++next;
+
+            return next - shift;
+        }
+    };
+
+    // A move of the loop, in frames, from the reader's position `from` on.
+    struct Move
+    {
+        std::uint64_t generation = 0;
+        SampleCount from = 0;
+        SampleCount fade = 0;
+        Map map;
+    };
+
+    static constexpr choc::buffer::FrameCount fadeChunk = 1024;
+
+    const Map own;
+    LaunchHandle::LoopSource* const live;
+    choc::buffer::ChannelArrayBuffer<float> fadeBuffer;
+    Move moves[2];
+    int numMoves = 0;
+    std::uint64_t seenGeneration = 0;
+    bool hasRead = false;
