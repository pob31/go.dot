#N canvas 0 50 720 450 12;
#X text 20 14 go.avg - the average of the last values \, or of the values that came in the last milliseconds. One of Go.dot's ready-made patches.;
#X floatatom 20 70 6 0 0 0 - - - 0;
#X msg 110 70 reset;
#X floatatom 170 70 6 0 0 0 - - - 0;
#X obj 20 110 go.avg 4;
#X floatatom 20 145 8 0 0 0 - - - 0;
#X floatatom 20 180 6 0 0 0 - - - 0;
#X msg 110 180 reset;
#X obj 20 220 go.avg 500 ms;
#X floatatom 20 255 8 0 0 0 - - - 0;
#X text 20 290 Left inlet: a number \, and the average goes out. Reset forgets the values.;
#X text 20 320 Right inlet: a new window \, in values or in ms as the box was made. It forgets the values.;
#X text 20 350 A window holds at most 1024 values.;
#X text 10 424 Part of Go.dot - https://github.com/pob31/go.dot - GPL-3.0-or-later \, Copyright (C) 2026 Pierre-Olivier Boulant;
#X connect 1 0 4 0;
#X connect 2 0 4 0;
#X connect 3 0 4 1;
#X connect 4 0 5 0;
#X connect 6 0 8 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
