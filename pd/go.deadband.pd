#N canvas 0 50 640 380 12;
#X text 10 10 go.deadband - a value passes only when it is further than the band from the last one that passed: go.deadband 4 lets 100 then 105 through but not 102. The first value passes. Reset forgets. Right inlet: the band.;
#X obj 10 70 inlet;
#X obj 400 70 inlet;
#X obj 10 100 route reset float;
#X obj 10 130 t f f;
#X obj 60 160 expr if(\$f3 == 0 || abs(\$f1-\$f2) > \$f4 \, 1 \, 0);
#X obj 10 190 spigot;
#X obj 10 220 t f f b;
#X msg 120 250 1;
#X obj 10 300 outlet;
#X msg 260 130 0;
#X obj 400 100 loadbang;
#X obj 400 130 f \$1;
#X obj 400 160 abs;
