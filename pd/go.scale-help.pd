#N canvas 0 50 720 420 12;
#X text 20 14 go.scale - a number from one range onto another \, upside down if the out range is.;
#X floatatom 20 70 6 0 0 0 - - - 0;
#X msg 110 70 in 0 127;
#X msg 206 70 out 1 0;
#X msg 290 70 clip 1;
#X obj 20 110 go.scale 0 1023 0 1;
#X floatatom 20 145 8 0 0 0 - - - 0;
#X floatatom 20 180 6 0 0 0 - - - 0;
#X obj 20 220 go.scale 0 1 -90 90 clip;
#X floatatom 20 255 8 0 0 0 - - - 0;
#X text 20 290 Arguments: in-low in-high out-low out-high \, and clip to keep the answer inside the out range.;
#X text 20 320 With no range it is 0..1 onto 0..1.;
#X text 10 394 Part of Go.dot - https://github.com/pob31/go.dot - GPL-3.0-or-later \, Copyright (C) 2026 Pierre-Olivier Boulant;
#X connect 1 0 5 0;
#X connect 2 0 5 0;
#X connect 3 0 5 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
