#N canvas 0 50 720 420 12;
#X text 20 14 go.hold - each number passes at once and is held. The resting value goes out when the time goes by with nothing new.;
#X floatatom 20 70 6 0 0 0 - - - 0;
#X msg 110 70 1;
#X msg 170 70 reset;
#X floatatom 230 70 6 0 0 0 - - - 0;
#X obj 20 110 go.hold 2000;
#X floatatom 20 145 8 0 0 0 - - - 0;
#X floatatom 20 180 6 0 0 0 - - - 0;
#X obj 20 220 go.hold 500 -1;
#X floatatom 20 255 8 0 0 0 - - - 0;
#X text 20 290 Arguments: the time in ms (100 by default) and the resting value (0 by default).;
#X text 20 320 A number that is the resting value passes and ends the hold. Reset ends it without a word.;
#X text 10 394 Part of Go.dot - https://github.com/pob31/go.dot - GPL-3.0-or-later \, Copyright (C) 2026 Pierre-Olivier Boulant;
#X connect 1 0 5 0;
#X connect 2 0 5 0;
#X connect 3 0 5 0;
#X connect 4 0 5 1;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
