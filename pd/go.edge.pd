#N canvas 0 50 700 380 12;
#X text 10 10 go.edge - a bang on the left when the value rises above the threshold \, on the right when it falls below: go.edge 512 20 crosses at 522 going up and 502 going down (a band of 20 so a jittery value crosses once). The first value says where it is and bangs nothing. Reset forgets. Right inlet: the threshold.;
#X obj 10 90 inlet;
#X obj 460 90 inlet;
#X obj 10 120 route reset float;
#X obj 10 160 expr if(\$f1 > \$f2 + \$f3/2 \, 1 \, if(\$f1 < \$f2 - \$f3/2 \, 0 \, \$f4)) \; if(\$f4 == 0 && \$f1 > \$f2 + \$f3/2 \, 1 \, if(\$f4 == 1 && \$f1 < \$f2 - \$f3/2 \, 2 \, 0));
#X obj 10 220 t f;
#X obj 300 220 sel 1 2;
#X obj 10 300 outlet;
#X obj 460 300 outlet;
#X msg 200 120 -1;
#X obj 520 120 loadbang;
#X obj 520 150 list append \$1 \$2;
#X obj 520 180 unpack f f;
