#N canvas 0 50 720 420 12;
#X text 20 14 go.smooth - each value moves the output part of the way \, which steadies a jittery sensor.;
#X floatatom 20 70 6 0 0 0 - - - 0;
#X msg 110 70 reset;
#X floatatom 170 70 6 0 0 0 - - - 0;
#X obj 20 110 go.smooth 0.75;
#X floatatom 20 145 8 0 0 0 - - - 0;
#X floatatom 20 180 6 0 0 0 - - - 0;
#X obj 20 220 go.smooth 0.95;
#X floatatom 20 255 8 0 0 0 - - - 0;
#X text 20 290 The argument is how much of the last output is kept \, 0 to 0.999: 0.95 is slow and smooth \, 0.5 quick.;
#X text 20 320 The first value is taken whole. Reset forgets \, so the next is too. For a glide over a time use [line].;
#X text 10 394 Part of Go.dot - https://github.com/pob31/go.dot - GPL-3.0-or-later \, Copyright (C) 2026 Pierre-Olivier Boulant;
#X connect 1 0 4 0;
#X connect 2 0 4 0;
#X connect 3 0 4 1;
#X connect 4 0 5 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
