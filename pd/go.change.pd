#N canvas 0 50 640 380 12;
#X text 10 10 go.change - a number or a word passes only when it is not the last one that passed. The first passes. Reset (or a bang on the right inlet) forgets.;
#X obj 10 70 inlet;
#X obj 400 70 inlet;
#X obj 10 100 route reset float symbol;
#X obj 10 130 t f f;
#X obj 60 160 expr if(\$f3 == 0 || abs(\$f1-\$f2) > \$f4 \, 1 \, 0);
#X obj 10 190 spigot;
#X obj 10 220 t f f b;
#X msg 120 250 1;
#X obj 10 300 outlet;
#X msg 260 130 0;
#X obj 160 220 sel go.change-forgotten;
#X obj 200 250 t s s;
#X msg 300 190 symbol go.change-forgotten;
