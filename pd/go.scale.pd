#N canvas 0 50 760 400 12;
#X text 10 10 go.scale - a number from one range onto another: go.scale 0 1023 0 1 takes 0..1023 onto 0..1. With no range \, 0..1 onto 0..1. Messages: in low high \, out low high \, clip 1 (or clip as a fifth argument) keeps the answer inside the out range.;
#X obj 10 90 inlet;
#X obj 10 105 list trim;
#X obj 10 130 route in out clip;
#X obj 120 150 unpack f f;
#X obj 220 150 unpack f f;
#X obj 10 220 expr if(\$f3 == \$f2 \, \$f4 \, if(\$f6 \, min(max(\$f4 + (\$f1-\$f2)*(\$f5-\$f4)/(\$f3-\$f2) \, min(\$f4 \, \$f5)) \, max(\$f4 \, \$f5)) \, \$f4 + (\$f1-\$f2)*(\$f5-\$f4)/(\$f3-\$f2)));
#X obj 10 300 outlet;
#X obj 480 90 loadbang;
#X obj 480 120 t b b;
#X obj 480 150 list append \$1 \$2 \$3 \$4;
#X obj 480 180 expr if(\$f1 == \$f2 \, 0 \, \$f1) \; if(\$f1 == \$f2 \, 1 \, \$f2) \; if(\$f1 == \$f2 \, 0 \, \$f3) \; if(\$f1 == \$f2 \, 1 \, \$f4);
#X obj 600 150 list append \$5;
#X obj 600 180 list trim;
#X obj 600 210 route clip;
#X msg 600 240 1;
