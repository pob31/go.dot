#N canvas 0 50 640 360 12;
#X text 10 10 go.smooth - each value moves the output part of the way: 0.75 keeps three quarters of the last output (the default). The first value is taken whole. Reset forgets. Right inlet: how much is kept \, 0 to 0.999.;
#X obj 10 70 inlet;
#X obj 400 70 inlet;
#X obj 10 100 route reset float;
#X obj 10 160 expr if(\$f3 \, \$f2*\$f4 + \$f1*(1-\$f4) \, \$f1);
#X obj 10 190 t f f b;
#X msg 120 220 1;
#X obj 10 250 outlet;
#X msg 200 130 0;
#X obj 400 100 loadbang;
#X obj 400 130 f \$1;
#X obj 400 160 sel 0;
#X msg 400 190 0.75;
#X obj 460 220 clip 0 0.999;
#X text 10 334 Part of Go.dot - https://github.com/pob31/go.dot - GPL-3.0-or-later \, Copyright (C) 2026 Pierre-Olivier Boulant;
#X connect 1 0 3 0;
#X connect 3 0 8 0;
#X connect 3 1 4 0;
#X connect 4 0 5 0;
#X connect 5 2 6 0;
#X connect 6 0 4 2;
#X connect 5 1 4 1;
#X connect 5 0 7 0;
#X connect 8 0 4 2;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 11 1 13 0;
#X connect 12 0 13 0;
#X connect 2 0 13 0;
#X connect 13 0 4 3;
