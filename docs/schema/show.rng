<?xml version="1.0" encoding="UTF-8"?>
<!--
  The grammar of a Go.dot bundle: show.xml, state.xml and the .wfg manifest.

  GENERATED. `wfg schema` writes this from the engine's schema table, which is
  itself generated from docs/parameters/godot-parameters.csv. A test fails when
  this committed copy and the generated one differ, so editing it by hand only
  produces a red build. Add the parameter to the CSV instead.

  Everything except `id` is optional, because the canonical writer omits an
  attribute holding its default and an absent attribute reads back AS its
  default. The grammar says which values are legal, not which are present.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <choice>
      <ref name="Show"/>
      <ref name="State"/>
      <ref name="Bundle"/>
    </choice>
  </start>

  <define name="identifier">
    <data type="string">
      <param name="pattern">[0-9A-HJKMNP-TV-Z]{8}</param>
    </data>
  </define>

  <define name="Show">
    <element name="Show">
      <optional>
        <attribute name="formatVersion">
          <a:documentation>The show format this document was written against.</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <ref name="Lists"/>
      </optional>
      <optional>
        <ref name="Mounts"/>
      </optional>
      <optional>
        <ref name="Audio"/>
      </optional>
      <optional>
        <ref name="MidiPorts"/>
      </optional>
      <optional>
        <ref name="Network"/>
      </optional>
      <optional>
        <ref name="Surfaces"/>
      </optional>
      <optional>
        <ref name="Dcas"/>
      </optional>
    </element>
  </define>

  <define name="Lists">
    <element name="Lists">
      <zeroOrMore>
        <ref name="List"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="List">
    <element name="List">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="name">
          <a:documentation>The cue list&apos;s name.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Transport"/>
          <ref name="Osc"/>
          <ref name="Midi"/>
          <ref name="Start"/>
          <ref name="Persistent"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Cue">
    <element name="Cue">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Trigger"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Group">
    <element name="Group">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="advance">
          <a:documentation>Whether a member starts when the previous completes or on GO.</a:documentation>
          <choice>
            <value>auto</value>
            <value>manual</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="dca">
          <a:documentation>The DCA this group is assigned to, by identifier, or empty. Adds the DCA&apos;s trim to the group run&apos;s own, which reaches every member through the sum a group already is (PRD 3.6, 3.28).</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="loops">
          <a:documentation>How many ROUNDS this group plays before it is done. Rounds, not playbacks: with play set, a round is a subset of the members, and three loops of two-of-five is six cues rather than three. Zero means for ever, which is what an ambience bed is, and is left by a stop verb, an advance or run.stop rather than by counting.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="mode">
          <a:documentation>Whether members are scheduled at entry, run one after another, or wait for a hand. sampler launches none of its members: GO arms the group, every member is loaded onto a strip, and faders and pads start them - in any order, any number of times, several at once (PRD 3.27).</a:documentation>
          <choice>
            <value>timeline</value>
            <value>sequence</value>
            <value>sampler</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="play">
          <a:documentation>How many members a round plays, out of however many there are (PRD 3.6 play N of M). Zero means all of them, which is the ordinary group. Larger than the membership is the same as all of them rather than a refusal: a designer deleting a member should not have their show stop loading.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="seed">
          <a:documentation>The seed a shuffled group draws its rounds from. Zero means a fresh one per run, drawn when the run starts and written into its log - so a shuffled show is different every night AND every night reproduces exactly. A seed set here is the other thing somebody wants: the same order at every performance, which is how a shuffled scene gets rehearsed.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="selection">
          <a:documentation>How the members of a round are ordered. sequential plays them as they are written; shuffle draws a fresh order for each round, redrawing until the first of the new round differs from the last of the one before it - so a member is never heard twice running across a boundary. With two members that constraint decides the order completely, which is correct rather than a degenerate case: alternating is what a designer asking for two shuffled ambiences means.</a:documentation>
          <choice>
            <value>sequential</value>
            <value>shuffle</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="takeover">
          <a:documentation>sampler: what arming this group does to the sampler groups already armed (PRD 3.27). group closes every other sampler group - each launches nothing new, plays out what is playing and hands each strip over as that clip ends; strip takes only the strips this group&apos;s members land on and leaves the rest to whoever had them, and a group that has lost every strip completes. Read when the group is armed and at each refresh.</a:documentation>
          <choice>
            <value>group</value>
            <value>strip</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Transport"/>
          <ref name="Osc"/>
          <ref name="Midi"/>
          <ref name="Start"/>
          <ref name="Header"/>
          <ref name="Footer"/>
          <ref name="Trigger"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Header">
    <element name="Header">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Transport"/>
          <ref name="Osc"/>
          <ref name="Midi"/>
          <ref name="Start"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Footer">
    <element name="Footer">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Transport"/>
          <ref name="Osc"/>
          <ref name="Midi"/>
          <ref name="Start"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Persistent">
    <element name="Persistent">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Transport"/>
          <ref name="Osc"/>
          <ref name="Midi"/>
          <ref name="Start"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Media">
    <element name="Media">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="channels">
          <a:documentation>How many channels the file has, decided when it was imported and written into the cue rather than read off the disk whenever it is wanted. The file travels between machines and may be absent tonight, and the routing below is shaped by this number - a cue whose count nobody knows cannot be pointed at an output without guessing what a guess would cost. Nought means nobody has said, which is every show written before the number existed.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">512</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="dca">
          <a:documentation>The DCA this cue is assigned to, by identifier, or empty. A mark on the member and never a list on the DCA (PRD 3.28), so assigning eight cues is a multi-select edit and nothing flows downward (4.12). Adds that DCA&apos;s trim, and the trim of every DCA it sits inside, to the level of every run of this cue - level only, one to one in dB; a mapping per assignment comes later.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="directOut">
          <a:documentation>The direct out this cue-s channels land on, by identifier; empty routes it nowhere by this road and is what every cue starts as. A mono cue feeds every channel of a stereo out; a cue wider than its out fails the run as bad-route rather than being quietly folded, unless stereoToMono says to fold it. Chosen among the outputs whose kind is direct - a mix channel is reached through a Send, at a level, which is the whole difference between the two.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="file">
          <a:documentation>The media to play, as a path relative to the bundle&apos;s media/ folder. Relative because a show travels between machines and an absolute path is a fact about the machine it was authored on. A file that is missing is reported when the show loads and fails the cue when it is armed - it never fails the load, because a show with one missing sound is still a show somebody has to run tonight.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="level">
          <a:documentation>The level the cue plays at, as decided. Not what it is doing: a fade writes run/&lt;id&gt;/level and leaves this alone, so the document keeps saying what somebody chose while the run says what is happening. -120 dB is silence rather than a very small number.</a:documentation>
          <data type="double">
            <param name="minInclusive">-120</param>
            <param name="maxInclusive">12</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="pressure">
          <a:documentation>sampler member: whether pressure on the pad - polyphonic aftertouch or channel pressure - rides the clip&apos;s trim while it is held, on velocity&apos;s scale: 127 is 0 dB, one is velocityFloor, and nought is ignored so a pad that rests at nought after the hit does not pull the sound down. A pad is a fader without a motor (author, 2026-09-23), and this is that fader.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="release">
          <a:documentation>sampler member: what letting go does. hold stops the clip on release - a pad lifted, a touched fader let go at silence - after the short releaseFade, so it does not click; playOut lets it run to its end, and silence on the fader is a mute rather than a stop.</a:documentation>
          <choice>
            <value>hold</value>
            <value>playOut</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="releaseFade">
          <a:documentation>sampler member: how long the fade to silence takes when a hold clip is released, or a play-out clip is stopped by a second press. Fifty milliseconds reads as a stop and does not click.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="secondPress">
          <a:documentation>sampler member, play-out only: what a press does while the clip is already playing. restart takes it from the top; noop leaves it alone; stop ends it with the release fade. A hold clip cannot be pressed again by the hand holding it, and a press from anywhere else is ignored while it is held (PRD 3.8, 3.27).</a:documentation>
          <choice>
            <value>restart</value>
            <value>noop</value>
            <value>stop</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="sharedOut">
          <a:documentation>This cue is MEANT to share its direct out with another. PRD 3.9c-s -allow marking deliberate sharing-, as feed/shared already gives a processor slot: the live-range analysis is conservative by design and reports overlaps it cannot prove impossible, so this is how a designer says of one pair that they considered it. It silences that pair-s warning and NOTHING ELSE - the menu still marks the out as taken, because which outs carry sound is a fact and the warning is a complaint, and only a complaint can be answered.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="startOffset">
          <a:documentation>How far into the file playback begins. A cue that starts at the downbeat rather than at the top of the recording.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="stereoToMono">
          <a:documentation>Fold a two-channel file to one before it is routed, each side at half, so a stereo recording can play out of a mono direct out. Ignored unless channels is 2: a fold is a statement about a stereo file, and applying it to a mono or a six-channel one would mean inventing a rule nobody asked for. PRD 3.18 leaves stereo-to-mono out of the RACK classes deliberately; this is the cue output stage, where the coefficients are the cue-s own and a fold costs nothing.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="velocity">
          <a:documentation>sampler member: whether the velocity of a press sets the level the clip starts at (author, 2026-09-23). Off, every press starts at unity trim, which is what a fader strip gives anyway. On, a press at 127 starts at 0 dB and a press at one at velocityFloor, in a straight line between them in dB.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="velocityFloor">
          <a:documentation>sampler member: the trim a press of velocity one starts at when velocity is on, and where a pressure of one takes it when pressure is on. -40 dB is a light tap on most pads; -120 is silence.</a:documentation>
          <data type="double">
            <param name="minInclusive">-120</param>
            <param name="maxInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="Route"/>
          <ref name="Send"/>
          <ref name="Feed"/>
          <ref name="Insert"/>
          <ref name="Range"/>
          <ref name="Trigger"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Route">
    <element name="Route">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="bus">
          <a:documentation>The identifier of the bus this destination feeds. A destination names a bus and never a hardware channel: the bus is where the author said a channel exists, and a show moved to a different rig re-points buses rather than every cue.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="gains">
          <a:documentation>The coefficients from the cue&apos;s channels to the bus&apos;s, row by row: input 0 to every bus channel, then input 1, and so on. Its length is the cue&apos;s channel count times the bus width, and a length that does not match is refused when the show loads rather than discovered mid-cue. A coefficient is a plain multiplier and carries no dB - level is the cue&apos;s, and this is where it goes.</a:documentation>
          <list>
            <zeroOrMore>
              <data type="double"/>
            </zeroOrMore>
          </list>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Range">
    <element name="Range">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="in">
          <a:documentation>Where in the file the range begins, in seconds. Ranges may be discontiguous and in any file order (author, 2026-09-06): a media cue with ranges is a playlist over one file, so the second range may start before the first ends, or before it begins.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="loops">
          <a:documentation>How many passes of this range before playback continues into the next. Nought is for ever, which is what an ambience bed is: it plays until something advances it. The count is of passes rather than of repeats, so one is the range played once.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the strip shows (PRD 3.24). A range is a region of a file that somebody named - the verse, the approach, the last eight bars - and the name is the only part of it a designer says out loud.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="out">
          <a:documentation>Where in the file it ends, in seconds. Checked against the file length when the cue is ARMED, which is when the file is read, and not when the show loads - a show whose media is not on this machine yet is still a show somebody has to open. An out that is not after its in fails the arm.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Trigger">
    <element name="Trigger">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="address">
          <a:documentation>osc: the address that fires this cue, arriving on Go.dot own OSC port over UDP. Refused at load if it falls under /godot or under a mount prefix, because those are NODES - a trigger there would be a message that both wrote a value and fired a cue, and nobody could tell which had been meant.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="at">
          <a:documentation>clock: a local time of day, HH:MM:SS, fired once each day it is crossed while the show is open. The wall clock is the one input the model refuses to read - nothing inside the engine reads a clock, which is what makes a replay reproducible - so a crossing is noticed outside it and arrives as a logged command like any other.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="channel">
          <a:documentation>midi: the channel, 1 to 16. Nought is any, and it is nought rather than -1 because MIDI channels are one-based everywhere a musician looks at them.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">16</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="data">
          <a:documentation>midi: the velocity or value that must match, or -1 for any. A note-on with velocity nought is a note-off on a great many devices, so matching on it is a thing somebody will need to do deliberately.</a:documentation>
          <data type="integer">
            <param name="minInclusive">-1</param>
            <param name="maxInclusive">127</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether it can fire. A trigger turned off during tech is still written down, which is the whole difference between disabling one and deleting it.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="kind">
          <a:documentation>What kind of thing fires it. The three inputs Phase 3 builds: a message on Go.dot own OSC port, a MIDI event on an input it was told to open, and a time of day. Timecode is Phase 10, and GO is not in this list at all - GO is the operator, and the only trigger that moves the standby (PRD 3.5).</a:documentation>
          <choice>
            <value>osc</value>
            <value>midi</value>
            <value>clock</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>midi: the note, controller or program number.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">127</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="port">
          <a:documentation>midi: the declared port the event must arrive on, by identifier. Empty is any input, which is what a rig with one MIDI cable wants. THE PORT AND NOT THE CABLE (2026-09-22): the show says &quot;Lights&quot; and the machine says which socket that is, so moving an interface changes one binding in the settings and every trigger that named the port goes on firing. Matching a device name here would mean editing every trigger in the show for a moved cable, which is the cost the port exists to avoid.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <a:documentation>midi: the event type. Four of them, which are the four a surface sends: the rest of the event types exist for MIDI CUES (PRD 3.10) rather than for listening.</a:documentation>
          <choice>
            <value>noteOn</value>
            <value>noteOff</value>
            <value>programChange</value>
            <value>controlChange</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="value">
          <a:documentation>osc: an argument the message must also carry, written the way the log writes one - f:1, i:3, T, s:go. Empty matches any arguments including none, which is what a bare address means to most of the things that will be sending one.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Fade">
    <element name="Fade">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="curve">
          <a:documentation>The shape it takes between the two levels. Linear in the dB domain, which is what a fader feels like; sCurve eases out of the start and into the end, for a fade that should not announce itself. The two shapes a fade has when nobody has drawn one: not read while points holds a curve, because two shapes multiplied together would be a third that nobody drew.</a:documentation>
          <choice>
            <value>linear</value>
            <value>sCurve</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="dca">
          <a:documentation>The DCA whose trim this fade moves, by identifier, instead of a cue&apos;s level. When it is set, target is not read: a DCA has no run to find, so the fade moves /godot/dca/&lt;id&gt;/trim from wherever it stands to level, and stopWhenDone means nothing. A second row rather than a wider target, because target names a cue and the refers check knows one kind per row.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="duration">
          <a:documentation>How long it takes. Zero is a jump, and it is the default so that a fade nobody has finished writing does something obvious rather than something slow and mysterious.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="level">
          <a:documentation>Where the fade ends, in dB. -120 is silence rather than a very small number, and it is the default because a fade to silence is what most fades are - a fresh fade cue is a slow cut to nothing, which is a real thing to want and can only ever make the show quieter. Not read while points holds a curve, whose last level is where that fade ends.</a:documentation>
          <data type="double">
            <param name="minInclusive">-120</param>
            <param name="maxInclusive">12</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="points">
          <a:documentation>A curve somebody drew, as (t, level) pairs: t a fraction of the duration and level in dB, within the -120..12 a fade&apos;s level may take. The fade meets each breakpoint at its time and runs straight in dB between them, which is what linear already means. Empty, the default, means curve applies - so a fade written before there was anything to draw with goes on meaning what it meant. Where it holds a curve it is the whole of the shape, and its last level is where the fade ends. The fade leaves from wherever the run&apos;s level is rather than from the first breakpoint&apos;s, for the reason a fade over a fade does: anything else is a jump, and a jump on a PA is a click. Refused, when written and when the show loads, unless it is pairs whose times climb strictly from exactly 0 to exactly 1.</a:documentation>
          <list>
            <zeroOrMore>
              <data type="double"/>
            </zeroOrMore>
          </list>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="stopWhenDone">
          <a:documentation>Whether the target&apos;s run is stopped when the fade arrives, at whatever level it arrives at. Off, a fade to silence leaves the run playing silently until it ends by itself, which is what a fade that will come back up wants; on, the arrival is the stop, the same path a stop cue&apos;s fade verb takes.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="target">
          <a:documentation>The cue whose sound this fade moves. It targets the CUE and finds its live run when it fires, because a cue is what somebody wrote down and a run is what happens to be playing - and the show has to say the first without knowing the second.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Trigger"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Transport">
    <element name="Transport">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="curve">
          <a:documentation>The shape of that fade. Ignored by a hard stop.</a:documentation>
          <choice>
            <value>linear</value>
            <value>sCurve</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="duration">
          <a:documentation>How long the fade half takes, when the verb is fade. Ignored by a hard stop.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="range">
          <a:documentation>Which slice of the target to go to, by identifier, when the verb is advance - and empty, which is what advance has always meant, is the NEXT one. Naming a slice is how a bed is sent to its outro from wherever it has got to rather than stepped through everything in between, which on a loop that never ends is the difference between a gesture and a wait. The slice still finishes the pass it is on before the jump, because that is what makes an advance graceful; a slice of some other cue is a warning and the run goes to the next one instead.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="target">
          <a:documentation>The cue this stops. As with a fade it names the cue and finds the run, and a target that is not running is a no-op that is applied rather than refused.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="verb">
          <a:documentation>How it stops. Hard stops now and takes Tracktion&apos;s own click suppression with it; fade runs a fade to silence first and stops when it arrives. The verb is separate from the duration so that a stop with a duration nobody meant cannot become a slow one by accident. afterMember and afterIteration are the two GRACEFUL ones, and they are only meaningful against a group: they let the scene reach a boundary it was going to reach anyway - the end of the member playing now, or the end of this round - and stop there, which is how an infinite loop is left without a cut. Against anything else they are a hard stop, because there is no boundary to wait for. advance is the third graceful one and belongs to a ranged media cue (PRD 3.24): it lets the range playing now finish the pass it is on and then leaves it, either into the next range or into silence - which is how an infinite ambience is got out of without a cut. Against a cue with no ranges it is a hard stop, for the same reason: there is no boundary.</a:documentation>
          <choice>
            <value>hard</value>
            <value>fade</value>
            <value>afterMember</value>
            <value>afterIteration</value>
            <value>advance</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Trigger"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Start">
    <element name="Start">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="target">
          <a:documentation>The cue this starts when it fires - by name, as cue.fire does, so standby does not move and the target may sit anywhere in any list. A start cue is a memo that presses a button (2026-09-19): it fires, its run is done the next tick, and the target runs on its own. What the live recorder writes into a take: one start cue per cue the operator fired, at the second they fired it, so a night pressed by hand can be played back by a timeline. A target that is a manual group is refused when it fires, as cue.fire refuses it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Trigger"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Osc">
    <element name="Osc">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="address">
          <a:documentation>The node this cue writes, which is an address in a mounted namespace rather than a message somebody composed. Naming the NODE is what lets the tree check it: a cue pointing at something the target does not have is findable before the show rather than during it, and the node already says what type it takes.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="timeout">
          <a:documentation>How long verified waits for an answer before failing the run. Ignored by the other two waits. Five seconds because it is long enough for a device that is thinking and short enough that a cue which is never going to answer does not hold a show past the point anybody would have given up on it. Zero means the first reply or nothing.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="value">
          <a:documentation>What to write, spelled the way the log spells an argument - f:0.5 for a float, i:3 for an integer, T for true. One atom, because a mounted node holds one value; the type is in the text so that a cue meaning the float and a cue meaning the integer are different cues rather than the same cue read twice by two machines.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="wait">
          <a:documentation>How long the cue takes to be done. None finishes as soon as it is fired; sent finishes when the datagram has left the socket; verified finishes when the target has been asked and has answered with the value that was written. A sequence of verified cues is a chain that waits for each device instead of hoping (PRD 3.11), and it is the only one of the three that can tell you the device disagreed.</a:documentation>
          <choice>
            <value>none</value>
            <value>sent</value>
            <value>verified</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Trigger"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Midi">
    <element name="Midi">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="channel">
          <a:documentation>The channel, one to sixteen. One-based because that is what is written on every device a musician has ever looked at, and unlike a TRIGGER&apos;s channel there is no &apos;any&apos;: a message has to go somewhere.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
            <param name="maxInclusive">16</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="data1">
          <a:documentation>The first byte of the message: the note for a note on, off or aftertouch, the controller for a control change, the program for a program change. Ignored by pitch bend, channel pressure and system exclusive, which have no such thing. NAMED AFTER ITS PLACE IN THE MESSAGE and not after any one of those meanings, because it is all of them depending on the type above it - and a client shows the word that fits, so nobody reads data1 anywhere but in the file. It was called number until 2026-09-22 and could not stay: every cue already has a number, which is its place in the list, and two rows of one name on one element are one attribute doing two jobs - the same twelve read as the cue&apos;s number and as the program it sends.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">127</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="data2">
          <a:documentation>The second byte: the velocity of a note, the value of a control change, the pressure of an aftertouch, or the whole fourteen bits of a pitch bend, where 8192 is the centre. Ignored by a program change, which has only one byte, and by system exclusive. Nought to 127 for everything but the bend. Renamed from data with its partner (2026-09-22) so the two read as the pair they are.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">16383</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="port">
          <a:documentation>The identifier of the declared &lt;Port&gt; this cue sends on. An identifier and not a name, for the reason a route names its bus by one: the name is what a person reads and what --midi-out is given, and renaming a port must not silence every cue that used it. A port that is declared and not bound fails the RUN with no-port and never the load, because which cable &quot;Lights&quot; is on is a fact about the building (PRD 4.10) and a show travels to a rig that has not been patched yet.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The ancestor group whose header prepares this cue, or empty for the ordinary case - prepared with its own group, as everything is. THE MARK IS THE DECISION AND THE HEADER LINE IS A READING OF IT (PRD 4.10): nothing is copied into the Header element, so editing the line is editing the member, deleting the member removes the line with no repair rule to write, and the two can never come to disagree because there is only one of them. It names an ANCESTOR rather than being a tickbox, because a cue three groups deep can be got ready by its own group, by the act, or by the opening scene, and which one is a decision about how early. A value naming a group that is not an ancestor is a validate warning and is ignored - not a refusal, because the repair is somebody dragging it somewhere sensible and yesterday-s show must still open.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The cue&apos;s name for a seven-character display, written by somebody rather than cut by the machine (PRD 3.16: authored short names, never auto-truncation). Empty, a strip display cuts the name to its width and says nothing about it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="sysex">
          <a:documentation>The bytes of a system-exclusive message, in hex, F0 to F7 inclusive - written the way a manual prints them, because that is where a designer is copying from. Ignored by every other type. A dump of any size is legal and the send is off the tick thread for exactly that reason: on Windows a hundred bytes busy-waits the calling thread for about thirty milliseconds.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <a:documentation>Which event to send. Every type PRD 3.10 lists, including sysex, because a show that can send seven of eight is a show somebody has to keep a second program open for. The type decides which of the fields below mean anything, which wfg validate says out loud rather than the grammar refusing - one element per type would be eight elements for one concept.</a:documentation>
          <choice>
            <value>noteOn</value>
            <value>noteOff</value>
            <value>programChange</value>
            <value>controlChange</value>
            <value>pitchBend</value>
            <value>aftertouch</value>
            <value>channelPressure</value>
            <value>sysex</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="wait">
          <a:documentation>How long the cue takes to be done. As a network cue, minus verified: MIDI has no read-back, so there is nothing that could answer, and asking for one is refused when the show loads rather than waiting for ever at half past seven. sent says the bytes reached the port.</a:documentation>
          <choice>
            <value>none</value>
            <value>sent</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Trigger"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="MidiPorts">
    <element name="MidiPorts">
      <zeroOrMore>
        <ref name="Port"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Port">
    <element name="Port">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="inputDevice">
          <a:documentation>The MIDI input this port listens on. Events arriving there are matched as THIS port, so a trigger names the port and never the cable - which is what makes moving an interface one edit instead of one per trigger. Empty listens to nothing; --midi-in overrides.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the show calls this port. The document holds what somebody decided (PRD 4.10), so it says &apos;Lights&apos; or &apos;The desk&apos;; --midi-out=&lt;name&gt;=&lt;device&gt; is what binds it to a cable on this machine, and the two are separate for the reason a bus and a hardware channel are.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="outputDevice">
          <a:documentation>The MIDI output on this machine this port sends through, by the name wfg midi lists. What somebody decided and what reads sensibly at the next venue, which is why it is in the show and not beside it (PRD 4.10); --midi-out overrides it for one session. Empty is unbound, and a cue on an unbound port fails its RUN with no-port and never the load, because a show travels to a rig nobody has patched yet.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="rx">
          <a:documentation>Whether events arriving on this port&apos;s input fire triggers. Off is a port that sends and does not listen, which is most of them - a lighting desk takes messages and has nothing to say back.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="tx">
          <a:documentation>Whether cues on this port are sent. Off, the cue still runs and finishes carrying the warning not-sent, exactly as a network device&apos;s tx does, so a rehearsal in a room without the desk plays the show instead of printing a column of failures.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Mounts">
    <element name="Mounts">
      <zeroOrMore>
        <ref name="Mount"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Mount">
    <element name="Mount">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="anticipatable">
          <a:documentation>Whether the mounted nodes may be pre-sent before GO. False for third parties.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="host">
          <a:documentation>Where the target is. A literal address rather than a name, because a socket resolves a hostname on every send whose destination differs from the last one, and a blocking lookup on the tick thread is a frame nobody gets back. It defaults to this machine because the ordinary rig is Go.dot and its processors on one box; anything else says so.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the show calls this device - &apos;Lighting desk&apos;, &apos;The WFS&apos; - which is what a target menu shows and what somebody reads in a list. The prefix stays the address: a name is for people and renaming one must not move a single cue, which is the reason a MIDI port has both too. Empty shows the prefix instead, so a device is never a blank row.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="namespace">
          <a:documentation>The bundle-relative OSCQuery namespace file describing the target, and EMPTY is the ordinary case for a device somebody typed an address into. Empty declares an OPAQUE device: nothing is published under its prefix, a cue aimed under it is sent exactly as it was written with no coercion and no read-back, and a cue whose wait is verified is refused when the show loads because there is nothing there to ask. A described device is the other half of PRD 3.22 and is unchanged: its nodes are checked, typed and askable.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="panic">
          <a:documentation>Default resting state for the mounted nodes.</a:documentation>
          <choice>
            <value>park</value>
            <value>snap</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="port">
          <a:documentation>The port the target listens on. Required, and deliberately without a default for the same reason audio/tracks is: no number could be right for every device, and a mount that guessed would send into the dark and report success. UDP never tells you nobody was listening, so this one has to be right in the document or it is never right at all.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
            <param name="maxInclusive">65535</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="prefix">
          <a:documentation>The address this device answers at, and the root every cue aimed at it carries. SEVERAL, separated by spaces, for a device whose addresses start at the root of its own world: a DiGiCo S21 reached directly answers at /channel for every strip control, /console for ping, pong and the channel counts, and /digico for snapshot recall, so its row reads &quot;/channel /console /digico&quot;. Declaring it three times would be three rows, three names and three sent counts for one console, and giving it one root that is not its own would mean the address in the cue is not the address in the manual somebody copied it from. A space is what separates them because an OSC address can never contain one, and a device with a single root reads exactly as it always did. A device that DESCRIBES itself has one: its namespace file is one tree and mounts in one place. EDITING THIS DOES NOT REWRITE THE CUES: a cue holds the whole address it writes, so a root somebody changes leaves every cue under the old one aiming at nothing, which wfg validate says out loud. Moving a cue from one device to another is the target menu&apos;s job.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="queryPort">
          <a:documentation>The port the target answers OSCQuery on, which is a different number from the one it listens for messages on - WFS-DIY takes messages on 8000 and describes itself on 5005. Zero means it was not declared, which is the only honest default: most devices do not run an OSCQuery server at all.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">65535</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="rateCap">
          <a:documentation>Default outbound rate cap for the mounted nodes.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="readback">
          <a:documentation>Whether this target can be ASKED what a value is, and how. Transport says how to send and says nothing about the other direction, so without this a cue whose wait is verified against a write-only device is a cue that can never succeed and nothing notices until the show. None is the default because it is true of most devices: OSCQuery was never standardised, and a mounted namespace is usually hand-written for a box that will never answer. A verified cue aimed at a none is refused when the show loads, which is the whole point of declaring it.</a:documentation>
          <choice>
            <value>none</value>
            <value>oscquery</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="rx">
          <a:documentation>Whether what this device sends is accepted. It is read today by one thing only: with strict senders on, a datagram from a host no declared device holds with rx set is dropped and logged rather than obeyed. What is DONE with what a device sends - a state machine watching it, a desk writing cues into the show - comes later, and the flag is stored now because it is a decision about the rig rather than a thing the machine noticed (PRD 4.10).</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="transport">
          <a:documentation>How the mounted target is reached. Only udp carries messages today; tcp and ws are declared because a document should be able to say what a device is before Go.dot can talk to it, and a mount declaring either is refused when the show loads rather than going quiet during it.</a:documentation>
          <choice>
            <value>udp</value>
            <value>tcp</value>
            <value>ws</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="tx">
          <a:documentation>Whether cues aimed at this device are put on the wire. Off, the cue still runs and still lands in the tree and the log - it finishes at once carrying the warning not-sent - so a rehearsal in a room without the desk plays the show instead of printing a column of failures. On is the default because a device somebody declared is a device they mean to talk to.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Slot"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Network">
    <element name="Network">
      <optional>
        <attribute name="strictSenders">
          <a:documentation>Whether messages are taken only from the devices this show declares. On, a datagram whose sender is not a declared device with rx set is dropped and written to the log as a refusal naming who sent it; off, which is the default and what Go.dot has always done, anybody who can reach the port is heard. It gates the OSC port alone: a client on the WebSocket is a client rather than a device, and gating those would lock the page and the tablet out of their own engine.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Audio">
    <element name="Audio">
      <optional>
        <attribute name="bufferSize">
          <a:documentation>Requested buffer size. Zero uses the device default; the granted size is observed.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">65536</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="channelsPerTrack">
          <a:documentation>How many channels one track carries, and so the widest cue this show can play. Two is a stereo file, which is what almost every show is; a six-channel bed or a first-order ambisonic one needs it said. A cue wider than this fails its arm as bad-route rather than being quietly narrowed - PRD 3.9b: width is explicit and never automatic. Fixed when the graph is built and never after, like tracks and for the same reason (3.25), so a show is reopened to change it. It costs: every track carries this many buffers whether a cue uses them or not.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
            <param name="maxInclusive">64</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="deviceType">
          <a:documentation>Audio driver type selected for this show.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Open the saved audio interface when this show starts.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="inputDevice">
          <a:documentation>Input interface selected for this show. Empty disables inputs.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="inputPatch">
          <a:documentation>Space-separated hardware input indices per logical input. Zero based; -1 disconnects. Empty preserves identity routing.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="outputDevice">
          <a:documentation>Output interface selected for this show. Empty selects the system default.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="outputPatch">
          <a:documentation>Space-separated hardware output indices per logical output. Zero based; -1 disconnects. Empty preserves identity routing.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="tracks">
          <a:documentation>How many cues can sound at once - the fixed number of audio tracks, and so the polyphony ceiling. Zero is legal and means a show with no audio. Required, and deliberately without a default: the number is a decision about the shape of a show, and no value here could be right for every rig. WRITABLE since 2026-09-21, because a decision a client cannot state is a decision nobody can take: it was read-only, no command set it, and a show made by File - New therefore declared nought and could never play anything. The graph is built from it when the audio settings are applied, so a change lands at the next apply and not under a running show - which is the same moment a changed buffer size lands.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <interleave>
        <optional>
          <ref name="Rack"/>
        </optional>
        <zeroOrMore>
          <ref name="Bus"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>

  <define name="Bus">
    <element name="Bus">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="firstChannel">
          <a:documentation>The first hardware output channel this bus occupies, counting from zero. Read-only at the door and maintained by bus.create, bus.delete, bus.move and bus.width, which repack every bus as the running sum of the widths before it: a client that could write this one could leave two buses overlapping, and nothing downstream would notice until a show night. A layout written by hand that is not packed is left exactly as it is and warned about, never rewritten.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="kind">
          <a:documentation>Whether this bus is a direct out - where one cue&apos;s own channels land, chosen from that cue&apos;s direct-out menu - or a mix channel that many cues send into at a level. The word decides which menu the bus appears in and nothing about the hardware: both kinds are contiguous output channels and both are summing points, so a second cue sent to a direct out is mixed there like anywhere else rather than refused.</a:documentation>
          <choice>
            <value>direct</value>
            <value>mix</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The bus name as the designer wrote it. Names are what appear in a dropdown and on a scribble strip; channel numbers are not.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="width">
          <a:documentation>How many consecutive channels the bus occupies - one for a mono output, two for a stereo pair, more for a processor send. Explicit and never inferred: the engine will not quietly widen or narrow a cue to make it fit. Read-only at the door and changed by bus.width, which repacks the channels after it.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
          </data>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Rack">
    <element name="Rack">
      <zeroOrMore>
        <ref name="Channel"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Channel">
    <element name="Channel">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="access">
          <a:documentation>Whether a cue holds this channel alone. A per-source insert is exclusive and is allocated; a reverb many cues send into is SHARED, which PRD 3.9e says is a bus with a chain rather than a slot - declared and published here, and never claimed.</a:documentation>
          <choice>
            <value>exclusive</value>
            <value>shared</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="class">
          <a:documentation>What this channel takes in and puts out. Stereo-to-mono is deliberately absent (PRD 3.18) and wider comes later. The class is the type a claim is matched against, the way a processor input-s width is.</a:documentation>
          <choice>
            <value>mono</value>
            <value>monoToStereo</value>
            <value>stereo</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the designer called it. PRD 3.9b: the names appear in the dropdown and on the OLED, and the channel numbers do not - -Voix solo- is what somebody wrote down and -input 3- is a fact about a patch that will change.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Slot">
    <element name="Slot">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="address">
          <a:documentation>The address of the input this slot is, under its own mount-s prefix: /wfs/input/3 and not input 3. The parameters underneath it - a position, a send, an LFO rate - are ordinary mounted nodes that an osc cue writes; this says which of them belong to the source a cue claims, which is what stops two cues fighting over one trajectory (PRD 3.9b).</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="bus">
          <a:documentation>The bus that carries audio into this input. A slot is a routing and a claim in one object: the audio reaches the processor through an ordinary bus, and the claim is what keeps a second cue out of the position and the LFO state behind it. Two separate objects would let a show route a cue somewhere it had not claimed.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="firstChannel">
          <a:documentation>Where in that bus this slot-s channels begin, counting from zero. The attribute that makes one wide send ordinary: a rig feeding a twelve-input processor has one twelve-channel bus rather than twelve buses, and the third input is channel two of it. Exactly bus/firstChannel-s idea one level down. firstChannel + width must fit inside the bus, checked when the show loads.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the designer called it. PRD 3.9b: the names appear in the dropdown and on the OLED, and the channel numbers do not - -Voix solo- is what somebody wrote down and -input 3- is a fact about a patch that will change.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="width">
          <a:documentation>How many channels the input takes. Explicit and never inferred, like a bus-s: PRD 3.9b refuses a silent downmix or upmix, and a slot is the one destination where width is enforced, because a slot has one and a bus is a summing point that does not care.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
          </data>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Feed">
    <element name="Feed">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="gains">
          <a:documentation>The coefficients from the cue-s channels to the slot-s, row by row, exactly as a route-s are. Its length is the cue-s channel count times the slot-s width, and a length that does not match is refused when the show loads. Required rather than defaulted to an identity: PRD 3.9b says width is explicit and never automatic, and what keeps that from being tedious is copy-assignment and multi-select edit rather than a default that is right until it is not.</a:documentation>
          <list>
            <zeroOrMore>
              <data type="double"/>
            </zeroOrMore>
          </list>
        </attribute>
      </optional>
      <optional>
        <attribute name="shared">
          <a:documentation>This cue is MEANT to share the slot with another. PRD 3.9c-s -allow marking deliberate sharing-: the live-range analysis is conservative by design and reports overlaps it cannot prove impossible, so this is how a designer says of one pair that they considered it. It silences that pair-s warning and nothing else.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="slot">
          <a:documentation>The processor input this cue feeds. A cue-s destinations are a list, not a choice (PRD 3.9b): a source into WFS plus a stereo feed to foldback is ordinary, so a Feed sits beside a Route rather than instead of one.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Insert">
    <element name="Insert">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="channel">
          <a:documentation>The rack channel this cue processes through. In Phase 4 the claim is bookkeeping and changes no sound: the pool and its claims are this phase-s, and the tracks, the sends and the plugins inside a channel are Phase 9-s (PRD 3.18).</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shared">
          <a:documentation>As feed/shared, for an exclusive channel two cues are meant to share.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Send">
    <element name="Send">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="bus">
          <a:documentation>The mix channel this send feeds. One Send per bus per cue: a second naming the same one is refused when it is created, because two sends into one mix are a level nobody can read off a fader.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="level">
          <a:documentation>How loud this cue arrives at that mix channel, on top of the cue-s own level - so a fade on the cue moves every send with it, which is what a designer means by fading a cue. -120 dB is silence rather than a very small number: a send at silence contributes no coefficient at all, and a track with nothing to add costs nothing to mix.</a:documentation>
          <data type="double">
            <param name="minInclusive">-120</param>
            <param name="maxInclusive">12</param>
          </data>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Surfaces">
    <element name="Surfaces">
      <zeroOrMore>
        <ref name="Surface"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Surface">
    <element name="Surface">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="channel">
          <a:documentation>midiPads: the channel the pads send on, one to sixteen, or nought for any.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">16</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the engine drives this surface at all. Off, nothing is sent to it and nothing it sends is heard; its strips still exist and are still filled, so a surface left in the van is still part of the layout the show was written for.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="firstNote">
          <a:documentation>midiPads: the note the first pad sends; the strips follow it upwards, one note each. 36 is where most pad controllers start.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">127</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the show calls this surface - &apos;The D700&apos;, &apos;Pads by the desk&apos;. A name for people; the profile says what the hardware is.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="ports">
          <a:documentation>The declared ports this surface is reached through, by identifier, space-separated, in bank order: the first port carries strips one to eight, the second nine to sixteen. The bank is the port and never the message (docs/D700_CONTROL_GUIDE.md 1.1), which is why this is a list. A virtual surface has none.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="preset">
          <a:documentation>The preset the hardware must be set to for this profile to read it - Mackie for the D700 - written down and shown to the operator, never detected: two presets can differ by one button, and a surface cannot be fingerprinted from its traffic (docs/godot-asparion-d700-protocol-0.1.md 5).</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="profile">
          <a:documentation>What kind of surface this is, which decides how its strips are driven and what each one has (PRD 3.16: a device profile is topology plus protocol). virtual is the desktop client&apos;s own panel and needs no port; mcu is a Mackie Control unit, eight fader strips per port; d700 is the Asparion D700, Mackie plus its native display, colour and rings, eight strips per port; midiPads is a pad controller sending notes with velocity and pressure. Changing it changes how the strips are driven and leaves the strips as they are.</a:documentation>
          <choice>
            <value>virtual</value>
            <value>mcu</value>
            <value>d700</value>
            <value>midiPads</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Strip"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Strip">
    <element name="Strip">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="dca">
          <a:documentation>The DCA a dca strip rides, by identifier. Read only when the role is dca; a dca strip naming nothing says unassigned and moves nothing.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the designer called it. PRD 3.9b: the names appear in the dropdown and on the OLED, and the channel numbers do not - -Voix solo- is what somebody wrote down and -input 3- is a fact about a patch that will change.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="role">
          <a:documentation>What this strip is for (PRD 3.9a, 3.27): a sampler strip is unpinned and filled by whichever sampler group is armed, in member order across the sampler strips of every surface; a dca strip is pinned to one DCA and never reassigned. The two may be mixed on one surface.</a:documentation>
          <choice>
            <value>sampler</value>
            <value>dca</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Dcas">
    <element name="Dcas">
      <zeroOrMore>
        <ref name="Dca"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Dca">
    <element name="Dca">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="dca">
          <a:documentation>The DCA this one sits inside, by identifier, or empty at the top. A nested DCA adds its parent&apos;s trim to its own (PRD 3.28), so Everything over Band over one guitar is three terms in one sum. A cycle is refused when it is written and when the show loads, because no reading of it says what anything should play at.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>What the DCA is called - &apos;Band&apos;, &apos;Ambiences&apos;, &apos;Everything&apos; - which is what a client and a wide display show.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shortName">
          <a:documentation>The name for a seven-character scribble strip, written by somebody rather than cut by the machine (PRD 3.16). Empty, a display cuts the name to its width.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State">
    <element name="State">
      <attribute name="formatVersion">
        <data type="integer"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="State.Show"/>
          <ref name="State.Lists"/>
          <ref name="State.List"/>
          <ref name="State.Group"/>
          <ref name="State.Port"/>
          <ref name="State.Audio"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="State.Show">
    <element name="Show">
      <optional>
        <attribute name="locked">
          <a:documentation>Show mode, and a lock on the show rather than a mode in a client. While it is true the engine refuses every change to what show.xml would record - a create, a delete, a move, or a write to any value that persists in the show - with the reason locked, whichever client sent it, because a lock that only one client honoured would lock exactly one of them - and the accident it exists for is the one PRD 3.17 names, a forearm on a screen in the dark. It locks nothing of where the operator is standing. GO, the standby, the focus, every run, load-to-time, a save and a write to a mounted device all keep working, and so does the write that sets this false again. Kept in state.xml beside the standby and the focus rather than in show.xml, because like them it belongs to the performance in progress and not to the show - and so an engine restarted in the middle of a performance comes back locked.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State.Lists">
    <element name="Lists">
      <optional>
        <attribute name="focus">
          <a:documentation>Which list GO acts on. Exactly one, and exclusive by construction rather than by upkeep - it is one value, so there is no flag anywhere to leave set. A list that has gone takes the focus with it and the first remaining list has it instead, which is why nothing has to remember to move this when a list is deleted. It is remembered across a save for the same reason the standby is: a rehearsal reopened where it was left is the kinder default, and losing state.xml costs only where somebody had got to.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State.List">
    <element name="List">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="finished">
          <a:documentation>Whether this list&apos;s pointer is empty because the list RAN OUT rather than because nobody has armed it. The two look identical - one empty string - and they are opposite facts about the show: a list nobody has parked on has had nothing happen to it, and a list whose last cue has been fired has had everything happen to it. Nothing needed to tell them apart until GO began clearing the pointer at the end (PRD 3.5, amended 2026-09-18); the persistent solver had been reading an empty pointer as the top of the list, so without this a show run through to its end would re-assert every persistent bed a Stop had suspended - the beds coming back on after the last cue. It goes true when a GO fires the last cue there is, false the moment anybody parks the pointer anywhere, and it is kept in state.xml beside the standby because it is the same fact about the same performance in progress. It is WRITABLE for the same reason the standby beside it is - the document&apos;s own door refuses a read-only attribute, and this is a fact about the pointer rather than a reading taken off one - but no client needs to touch it: standby.set clears it, and firing the last cue is what sets it.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="persistentFolded">
          <a:documentation>Whether the list&apos;s persistent section is drawn shut. Recorded with the show (author, 2026-09-18: &apos;fold state should be recorded in project file&apos;) as state, since how a list is read is not a decision about what it plays: it lands in state.xml beside the standby and does not mark the show unsaved.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="standby">
          <a:documentation>The cue GO will act on. One per list, and always one of that list&apos;s own top-level children or empty; moved only by a standby command, a write to this node, or the repair when the cue it names is deleted or moved away. Never by selection or scrolling.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State.Group">
    <element name="Group">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="folded">
          <a:documentation>Whether the group is drawn shut, its members hidden under its row. State, not show: how a group is read is not a decision about what it plays, so it lands in state.xml and does not mark the show unsaved.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="footerFolded">
          <a:documentation>Whether the group&apos;s footer band is drawn shut. State, as `folded` is.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="headerFolded">
          <a:documentation>Whether the group&apos;s header band is drawn shut. State, as `folded` is.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State.Port">
    <element name="Port">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="inputDeviceId">
          <a:documentation>The identifier that input had when this machine last found it, tried before the name, for the reason the output&apos;s twin gives.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="outputDeviceId">
          <a:documentation>The identifier that output had when this machine last found it, tried BEFORE the name. Two things fail in opposite directions and that is why both are kept: an identifier is operating-system formatted and is not stable - on Windows it carries the device&apos;s instance path, so moving a cable to another USB socket changes it - while a name survives the move and cannot tell two identical interfaces apart. State rather than show: it is what the machine matched and not what anybody decided, so it never dirties the show, and a stale one at another venue simply fails and falls through to the name. Written back by the engine whenever a port binds by name, so the next start is exact.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State.Audio">
    <element name="Audio">
      <optional>
        <attribute name="patchSettled">
          <a:documentation>Whether the output patch has stopped following the output layout one for one. False in a fresh show: the patch stays empty, which the device layer already reads as identity, so every output added, removed, moved or widened simply re-flows it and the designer never touches a matrix. It goes true when somebody edits the patch by hand, and when the first media run launches with audio - after which every output keeps the interface channels it has and a new one takes the next free ones. State rather than show: it records what has happened to this rig, not a decision about what the show plays, so it lands in state.xml beside the standby and does not mark the show unsaved.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Bundle">
    <element name="Bundle">
      <attribute name="formatVersion">
        <data type="integer"/>
      </attribute>
    </element>
  </define>

</grammar>
