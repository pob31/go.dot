<?xml version="1.0" encoding="UTF-8"?>
<!--
  The grammar of a Go.dot bundle: show.xml, state.xml and the .wfg manifest.

  GENERATED. `wfg schema` writes this from the engine's schema table, which is
  itself generated from docs/parameters/godot-parameters.csv. A test fails when
  this committed copy and the generated one differ, so editing it by hand only
  produces a red build. Add the parameter to the CSV instead.

  Everything except `id` is optional, because the canonical writer omits an
  attribute holding its default and an absent attribute reads back AS its
  default. The grammar says which values are legal, not which are present.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <choice>
      <ref name="Show"/>
      <ref name="State"/>
      <ref name="Bundle"/>
    </choice>
  </start>

  <define name="identifier">
    <data type="string">
      <param name="pattern">[0-9A-HJKMNP-TV-Z]{8}</param>
    </data>
  </define>

  <define name="Show">
    <element name="Show">
      <optional>
        <attribute name="formatVersion">
          <a:documentation>The show format this document was written against.</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <ref name="Lists"/>
      <ref name="Mounts"/>
      <ref name="Audio"/>
    </element>
  </define>

  <define name="Lists">
    <element name="Lists">
      <zeroOrMore>
        <ref name="List"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="List">
    <element name="List">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="name">
          <a:documentation>The cue list&apos;s name.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Stop"/>
          <ref name="Osc"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Cue">
    <element name="Cue">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Group">
    <element name="Group">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="advance">
          <a:documentation>Whether a member starts when the previous completes or on GO.</a:documentation>
          <choice>
            <value>auto</value>
            <value>manual</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="loops">
          <a:documentation>How many ROUNDS this group plays before it is done. Rounds, not playbacks: with play set, a round is a subset of the members, and three loops of two-of-five is six cues rather than three. Zero means for ever, which is what an ambience bed is, and is left by a stop verb, an advance or run.stop rather than by counting.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="mode">
          <a:documentation>Whether members are scheduled at entry or run one after another.</a:documentation>
          <choice>
            <value>timeline</value>
            <value>sequence</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="play">
          <a:documentation>How many members a round plays, out of however many there are (PRD 3.6 play N of M). Zero means all of them, which is the ordinary group. Larger than the membership is the same as all of them rather than a refusal: a designer deleting a member should not have their show stop loading.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="seed">
          <a:documentation>The seed a shuffled group draws its rounds from. Zero means a fresh one per run, drawn when the run starts and written into its log - so a shuffled show is different every night AND every night reproduces exactly. A seed set here is the other thing somebody wants: the same order at every performance, which is how a shuffled scene gets rehearsed.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="selection">
          <a:documentation>How the members of a round are ordered. sequential plays them as they are written; shuffle draws a fresh order for each round, redrawing until the first of the new round differs from the last of the one before it - so a member is never heard twice running across a boundary. With two members that constraint decides the order completely, which is correct rather than a degenerate case: alternating is what a designer asking for two shuffled ambiences means.</a:documentation>
          <choice>
            <value>sequential</value>
            <value>shuffle</value>
          </choice>
        </attribute>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Stop"/>
          <ref name="Osc"/>
          <ref name="Header"/>
          <ref name="Footer"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Header">
    <element name="Header">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Stop"/>
          <ref name="Osc"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Footer">
    <element name="Footer">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="Cue"/>
          <ref name="Group"/>
          <ref name="Media"/>
          <ref name="Fade"/>
          <ref name="Stop"/>
          <ref name="Osc"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="Media">
    <element name="Media">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="file">
          <a:documentation>The media to play, as a path relative to the bundle&apos;s media/ folder. Relative because a show travels between machines and an absolute path is a fact about the machine it was authored on. A file that is missing is reported when the show loads and fails the cue when it is armed - it never fails the load, because a show with one missing sound is still a show somebody has to run tonight.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="level">
          <a:documentation>The level the cue plays at, as decided. Not what it is doing: a fade writes run/&lt;id&gt;/level and leaves this alone, so the document keeps saying what somebody chose while the run says what is happening. -120 dB is silence rather than a very small number.</a:documentation>
          <data type="double">
            <param name="minInclusive">-120</param>
            <param name="maxInclusive">12</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="startOffset">
          <a:documentation>How far into the file playback begins. A cue that starts at the downbeat rather than at the top of the recording.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Route"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Route">
    <element name="Route">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="bus">
          <a:documentation>The identifier of the bus this destination feeds. A destination names a bus and never a hardware channel: the bus is where the author said a channel exists, and a show moved to a different rig re-points buses rather than every cue.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="gains">
          <a:documentation>The coefficients from the cue&apos;s channels to the bus&apos;s, row by row: input 0 to every bus channel, then input 1, and so on. Its length is the cue&apos;s channel count times the bus width, and a length that does not match is refused when the show loads rather than discovered mid-cue. A coefficient is a plain multiplier and carries no dB - level is the cue&apos;s, and this is where it goes.</a:documentation>
          <list>
            <zeroOrMore>
              <data type="double"/>
            </zeroOrMore>
          </list>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Fade">
    <element name="Fade">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="curve">
          <a:documentation>The shape it takes between the two levels. Linear in the dB domain, which is what a fader feels like; sCurve eases out of the start and into the end, for a fade that should not announce itself. Two shapes until the curve editor of Phase 5.</a:documentation>
          <choice>
            <value>linear</value>
            <value>sCurve</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="duration">
          <a:documentation>How long it takes. Zero is a jump, and it is the default so that a fade nobody has finished writing does something obvious rather than something slow and mysterious.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="level">
          <a:documentation>Where the fade ends, in dB. -120 is silence rather than a very small number, and it is the default because a fade to silence is what most fades are - a fresh fade cue is a slow cut to nothing, which is a real thing to want and can only ever make the show quieter.</a:documentation>
          <data type="double">
            <param name="minInclusive">-120</param>
            <param name="maxInclusive">12</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="target">
          <a:documentation>The cue whose sound this fade moves. It targets the CUE and finds its live run when it fires, because a cue is what somebody wrote down and a run is what happens to be playing - and the show has to say the first without knowing the second.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Stop">
    <element name="Stop">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="curve">
          <a:documentation>The shape of that fade. Ignored by a hard stop.</a:documentation>
          <choice>
            <value>linear</value>
            <value>sCurve</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="duration">
          <a:documentation>How long the fade half takes, when the verb is fade. Ignored by a hard stop.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="target">
          <a:documentation>The cue this stops. As with a fade it names the cue and finds the run, and a target that is not running is a no-op that is applied rather than refused.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="verb">
          <a:documentation>How it stops. Hard stops now and takes Tracktion&apos;s own click suppression with it; fade runs a fade to silence first and stops when it arrives. The verb is separate from the duration so that a stop with a duration nobody meant cannot become a slow one by accident. afterMember and afterIteration are the two GRACEFUL ones, and they are only meaningful against a group: they let the scene reach a boundary it was going to reach anyway - the end of the member playing now, or the end of this round - and stop there, which is how an infinite loop is left without a cut. Against anything else they are a hard stop, because there is no boundary to wait for.</a:documentation>
          <choice>
            <value>hard</value>
            <value>fade</value>
            <value>afterMember</value>
            <value>afterIteration</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Osc">
    <element name="Osc">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="address">
          <a:documentation>The node this cue writes, which is an address in a mounted namespace rather than a message somebody composed. Naming the NODE is what lets the tree check it: a cue pointing at something the target does not have is findable before the show rather than during it, and the node already says what type it takes.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="colour">
          <a:documentation>A #RRGGBB decoration. Never the sole carrier of information.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="enabled">
          <a:documentation>Whether the cue runs at all. A disabled cue is skipped, not deleted.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The cue&apos;s name, as the operator reads it.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="notes">
          <a:documentation>Free text for the designer.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="number">
          <a:documentation>The decimal cue number. A string, because 12.5.1 is one; mutable, renumbered during tech, and never an identity.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="postWait">
          <a:documentation>How long after completion before this cue reports done to its parent. A group is complete once every member is, its members&apos; own post-waits included; the group&apos;s post-wait then runs on top of that.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="preWait">
          <a:documentation>How long after entry before this cue starts. A group has one of its own, and it runs before its members begin their own pre-waits, so raising it defers the whole group.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="timeout">
          <a:documentation>How long verified waits for an answer before failing the run. Ignored by the other two waits. Five seconds because it is long enough for a device that is thinking and short enough that a cue which is never going to answer does not hold a show past the point anybody would have given up on it. Zero means the first reply or nothing.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="value">
          <a:documentation>What to write, spelled the way the log spells an argument - f:0.5 for a float, i:3 for an integer, T for true. One atom, because a mounted node holds one value; the type is in the text so that a cue meaning the float and a cue meaning the integer are different cues rather than the same cue read twice by two machines.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="wait">
          <a:documentation>How long the cue takes to be done. None finishes as soon as it is fired; sent finishes when the datagram has left the socket; verified finishes when the target has been asked and has answered with the value that was written. A sequence of verified cues is a chain that waits for each device instead of hoping (PRD 3.11), and it is the only one of the three that can tell you the device disagreed.</a:documentation>
          <choice>
            <value>none</value>
            <value>sent</value>
            <value>verified</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Mounts">
    <element name="Mounts">
      <zeroOrMore>
        <ref name="Mount"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Mount">
    <element name="Mount">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="anticipatable">
          <a:documentation>Whether the mounted nodes may be pre-sent before GO. False for third parties.</a:documentation>
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="host">
          <a:documentation>Where the target is. A literal address rather than a name, because a socket resolves a hostname on every send whose destination differs from the last one, and a blocking lookup on the tick thread is a frame nobody gets back. It defaults to this machine because the ordinary rig is Go.dot and its processors on one box; anything else says so.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="namespace">
          <a:documentation>The bundle-relative OSCQuery namespace file describing the target.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="panic">
          <a:documentation>Default resting state for the mounted nodes.</a:documentation>
          <choice>
            <value>park</value>
            <value>snap</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="port">
          <a:documentation>The port the target listens on. Required, and deliberately without a default for the same reason audio/tracks is: no number could be right for every device, and a mount that guessed would send into the dark and report success. UDP never tells you nobody was listening, so this one has to be right in the document or it is never right at all.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
            <param name="maxInclusive">65535</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="prefix">
          <a:documentation>The address the foreign namespace is mounted at.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="queryPort">
          <a:documentation>The port the target answers OSCQuery on, which is a different number from the one it listens for messages on - WFS-DIY takes messages on 8000 and describes itself on 5005. Zero means it was not declared, which is the only honest default: most devices do not run an OSCQuery server at all.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
            <param name="maxInclusive">65535</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="rateCap">
          <a:documentation>Default outbound rate cap for the mounted nodes.</a:documentation>
          <data type="double">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="readback">
          <a:documentation>Whether this target can be ASKED what a value is, and how. Transport says how to send and says nothing about the other direction, so without this a cue whose wait is verified against a write-only device is a cue that can never succeed and nothing notices until the show. None is the default because it is true of most devices: OSCQuery was never standardised, and a mounted namespace is usually hand-written for a box that will never answer. A verified cue aimed at a none is refused when the show loads, which is the whole point of declaring it.</a:documentation>
          <choice>
            <value>none</value>
            <value>oscquery</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="transport">
          <a:documentation>How the mounted target is reached. Only udp carries messages today; tcp and ws are declared because a document should be able to say what a device is before Go.dot can talk to it, and a mount declaring either is refused when the show loads rather than going quiet during it.</a:documentation>
          <choice>
            <value>udp</value>
            <value>tcp</value>
            <value>ws</value>
          </choice>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Audio">
    <element name="Audio">
      <optional>
        <attribute name="tracks">
          <a:documentation>The fixed number of audio tracks, and so the polyphony ceiling: N tracks is N simultaneous cues. Zero is legal and means a show with no audio. Required, and deliberately without a default - the number is a decision about the shape of a show, and no value here could be right for every rig.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <zeroOrMore>
        <ref name="Bus"/>
      </zeroOrMore>
    </element>
  </define>

  <define name="Bus">
    <element name="Bus">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="firstChannel">
          <a:documentation>The first hardware output channel this bus occupies, counting from zero.</a:documentation>
          <data type="integer">
            <param name="minInclusive">0</param>
          </data>
        </attribute>
      </optional>
      <optional>
        <attribute name="name">
          <a:documentation>The bus name as the designer wrote it. Names are what appear in a dropdown and on a scribble strip; channel numbers are not.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="width">
          <a:documentation>How many consecutive channels the bus occupies. Explicit and never inferred: the engine will not quietly widen or narrow a cue to make it fit.</a:documentation>
          <data type="integer">
            <param name="minInclusive">1</param>
          </data>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State">
    <element name="State">
      <attribute name="formatVersion">
        <data type="integer"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="State.Lists"/>
          <ref name="State.List"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="State.Lists">
    <element name="Lists">
      <optional>
        <attribute name="focus">
          <a:documentation>Which list GO acts on. Exactly one, and exclusive by construction rather than by upkeep - it is one value, so there is no flag anywhere to leave set. A list that has gone takes the focus with it and the first remaining list has it instead, which is why nothing has to remember to move this when a list is deleted. It is remembered across a save for the same reason the standby is: a rehearsal reopened where it was left is the kinder default, and losing state.xml costs only where somebody had got to.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="State.List">
    <element name="List">
      <attribute name="id">
        <ref name="identifier"/>
      </attribute>
      <optional>
        <attribute name="standby">
          <a:documentation>The cue GO will act on. One per list, and always one of that list&apos;s own top-level children or empty; moved only by a standby command, a write to this node, or the repair when the cue it names is deleted or moved away. Never by selection or scrolling.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
    </element>
  </define>

  <define name="Bundle">
    <element name="Bundle">
      <attribute name="formatVersion">
        <data type="integer"/>
      </attribute>
    </element>
  </define>

</grammar>
