<Show>
  <Lists>
    <List id="P4ACT001" name="Act One">
      <Group id="P4GRP001" advance="auto" name="The scene" number="1">
        <Media id="P4MED001" file="segments.wav" name="The bed" number="1.1">
          <Feed id="P4FED001" gains="1 0" slot="P4SXA001"/>
          <Insert id="P4NSR001" channel="P4CHN001"/>
        </Media>
        <Osc id="P4MSG001" address="/desk/fader" name="Position the input" number="1.2" preset="P4GRP001" timeout="5" value="f:0.75" wait="verified"/>
        <Group id="P4GRP002" mode="timeline" name="Two at once" number="1.3">
          <Media id="P4RMP001" file="ramp.wav" name="The ramp" number="1.3.1">
            <Route id="P4RTE001" bus="P4BSB001" gains="1 0"/>
          </Media>
          <Media id="P4MED002" file="segments.wav" level="-6" name="Beside it" number="1.3.2" preWait="2">
            <Route id="P4RTE002" bus="P4BSB001" gains="0 1"/>
          </Media>
        </Group>
        <Footer id="P4FTR001">
          <Osc id="P4MSG002" address="/desk/mute" name="Release the input" number="1.f" value="T" wait="sent"/>
        </Footer>
      </Group>
      <Media id="P4MED003" file="segments.wav" level="-12" name="After the scene" number="2">
        <Feed id="P4FED002" gains="1 0" slot="P4SXA001"/>
      </Media>
      <Fade id="P4FAD001" duration="0.3" level="-20" name="Under the dialogue" number="3" target="P4MED003"/>
      <Persistent id="P4PST001">
        <Osc id="P4MSG003" address="/desk/scene" name="Hold the scene" value="i:7" wait="sent"/>
      </Persistent>
    </List>
    <List id="P4FYR001" name="Foyer">
      <Cue id="P4MEM001" name="Doors" number="1">
        <Trigger id="P4TRG001" address="/foyer/doors" kind="osc"/>
      </Cue>
    </List>
  </Lists>
  <Mounts>
    <Mount id="P4MNT001" anticipatable="true" namespace="namespaces/desk.json" port="9000" prefix="/desk" queryPort="5005" readback="oscquery">
      <Slot id="P4SXA001" address="/desk/input/1" bus="P4BSC001" name="Processor in 1" width="1"/>
      <Slot id="P4SXB001" address="/desk/input/2" bus="P4BSC001" firstChannel="1" name="Processor in 2" width="1"/>
    </Mount>
  </Mounts>
  <Audio tracks="4">
    <Bus id="P4BSA001" name="Main L/R" width="2"/>
    <Bus id="P4BSB001" firstChannel="2" name="Foldback" width="2"/>
    <Bus id="P4BSC001" firstChannel="4" name="To the processor" width="2"/>
    <Rack>
      <Channel id="P4CHN001" access="exclusive" class="mono" name="Reverb A"/>
    </Rack>
  </Audio>
</Show>
