@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:godot:test-lv2-gain>
    a lv2:Plugin ;
    lv2:binary <@GODOT_TEST_LV2_BINARY@> ;
    rdfs:seeAlso <plugin.ttl> .

<urn:godot:test-lv2-widen>
    a lv2:Plugin ;
    lv2:binary <@GODOT_TEST_LV2_BINARY@> ;
    rdfs:seeAlso <plugin.ttl> .
